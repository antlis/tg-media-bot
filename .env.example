# ===== Required ==============================================================

# Bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (ask @userinfobot).
# Leave empty and ANYONE can use the bot — and your server.
ALLOWED_USERS=

# Comma-separated Telegram user IDs with administrator rights (/stats, /broadcast, /cleancache, crash alerts).
# If left empty, allowed users (from ALLOWED_USERS) have admin access.
# ADMIN_USERS=

# Local Bot API server credentials (docker-compose only), from
# https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ===== Language ==============================================================

# Language for chats that have not picked one with /lang and whose user
# language Telegram does not report: en | ru | uk | es
# DEFAULT_LANG=en

# ===== Resource limits (the defaults suit a 1 vCPU / 1 GB VPS) ===============

# Downloads running at the same time. Every one is a yt-dlp (+ ffmpeg) process
# using 100–300 MB of RAM. Others wait in the queue.
# MAX_PARALLEL_DOWNLOADS=1

# Personal queue: how many links one user may have queued (waiting + running),
# and how many of them download at the same time. Users take turns for the
# global slots above, so one long queue does not block everybody else.
# USER_QUEUE_SIZE=100
# RATE_LIMIT_PER_USER=1

# All users' queued links together.
# MAX_QUEUE_SIZE=1000

# Largest file to send, in MB. Capped by Telegram: 50 with the public API,
# 2000 with the local Bot API server. Quality is lowered automatically to fit.
# MAX_FILE_SIZE_MB=

# Longest media accepted, in minutes (0 = no limit). Checked before downloading.
# MAX_DURATION_MIN=180

# Highest video resolution to download.
# MAX_HEIGHT=1080

# Abort a single download after this many seconds.
# DOWNLOAD_TIMEOUT=1800

# Refuse new downloads when the temp dir's disk has less free space (MB).
# 300 for public API (50 MB limit); 1500–2000 recommended when local Bot API is used (2 GB files).
# MIN_FREE_DISK_MB=300

# HLS/DASH fragments fetched in parallel per download.
# CONCURRENT_FRAGMENTS=4

# Bandwidth cap per download (yt-dlp syntax: 5M, 500K). Empty = unlimited.
# DOWNLOAD_RATE_LIMIT=

# CPU priority of yt-dlp/ffmpeg (0 = normal … 19 = lowest).
# CHILD_NICE=10

# ===== Conversion ============================================================

# Video is never re-encoded when it can be avoided (H.264 is sent as-is, other
# containers are remuxed). auto: short clips that would not play inline
# (e.g. WebM/VP8) are converted to H.264. never: send them as files instead.
# TRANSCODE=auto
# TRANSCODE_MAX_DURATION=600
# TRANSCODE_HEIGHT=720
# FFMPEG_THREADS=1

# auto: keep AAC/MP3 audio as-is (no re-encode), convert the rest to MP3.
# mp3: always MP3.
# AUDIO_FORMAT=auto
# MP3 VBR quality, 0 (best) … 9.
# AUDIO_QUALITY=4

# ===== Networking & auth =====================================================

# Netscape cookies.txt for sites that need a login (age-restricted, Instagram…).
# COOKIES_FILE=/cookies/cookies.txt

# Bare-metal only: read cookies straight from a local browser profile.
# USE_BROWSER_COOKIES=false
# BROWSER_NAME=firefox

# Proxy used only to retry after a geo/region or connectivity block.
# PROXY_URL=socks5h://user:pass@host:port

# Refuse links to localhost / private networks (protects your LAN).
# BLOCK_PRIVATE_URLS=true

# Directory with extractor plugins (executables; see README).
# PLUGIN_DIR=

# Extra arguments appended to every yt-dlp call.
# YTDLP_EXTRA_ARGS=

# ===== Paths & service =======================================================

# Local Bot API server URL (set by docker-compose). Empty = api.telegram.org.
# API_SERVER_URL=
# Hand file paths to the local API server instead of uploading over HTTP.
# Requires the temp dir to be visible to the server at the same path.
# LOCAL_API_SHARED_FILES=false

# State (settings, file_id cache) and downloads. Keep TEMP_DIR on disk, not tmpfs.
# DATA_DIR=data
# TEMP_DIR=data/tmp

# Command that updates yt-dlp; run every YTDLP_UPDATE_INTERVAL_HOURS while idle.
# YTDLP_UPDATE_CMD=
# YTDLP_UPDATE_INTERVAL_HOURS=24

# Binaries, if not on PATH.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Seconds between progress message edits.
# PROGRESS_INTERVAL=5

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
# Also write logs here (rotated at 5 MB, 3 backups).
# LOG_FILE=
